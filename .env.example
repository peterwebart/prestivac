# ---------------------------------------------------------------------------
# PrestiVac — environment variables
# Copy the values you need into Coolify's environment settings for the app.
# Never commit real values; this file documents the names only.
# ---------------------------------------------------------------------------

# Quote form delivery (RECOMMENDED — enables conversion tracking)
#
# Any HTTPS endpoint that accepts a JSON POST and forwards it to
# info@prestivac.com. The form sends every field plus a reference number
# (PV-YYYYMMDD-XXXX) and the source page, so you can see which page produced
# each enquiry.
#
# Three ways to get a URL, cheapest first:
#   1. Zapier / Make / n8n  — create a "Webhook" trigger, action "send email"
#      to info@prestivac.com. Copy the webhook URL here. No code.
#   2. Your CRM's inbound webhook — HubSpot, Pipedrive, Zoho all provide one,
#      which also gets the enquiry into the pipeline rather than just an inbox.
#   3. A transactional mail service (Resend, Postmark, SendGrid) behind a small
#      forwarding endpoint.
#
# WITHOUT this variable the form still works: it falls back to composing a
# pre-filled email to info@prestivac.com containing every answer and the
# reference number. Nothing is lost — but a mail draft cannot be counted as a
# conversion in Google Ads or GA4, so paid spend cannot be attributed.
QUOTE_WEBHOOK_URL=

# Contact form delivery (optional)
#
# Falls back to QUOTE_WEBHOOK_URL when unset, so configuring one endpoint makes
# BOTH forms deliver. Payloads carry form: "quote" or "contact" so a single
# endpoint can route by type.
CONTACT_WEBHOOK_URL=

# Conversion tracking
#
# The quote form pushes a `generate_lead` dataLayer event on every successful
# submission, on BOTH delivery paths, carrying:
#   source     which page produced the lead
#   reference  PV-YYYYMMDD-XXXX, matching the customer's confirmation
#   delivery   "webhook" or "mail_fallback" — so you can see whether
#              QUOTE_WEBHOOK_URL is actually receiving submissions
#   locale     "en" or "fr"
#
# To make it count as a conversion:
#   1. GA4 — create a custom event named generate_lead, mark it as a conversion.
#   2. Google Ads — import that GA4 conversion, or trigger on the same event
#      name in Google Tag Manager.
# No tag container needs to exist for the site to work; the push is a no-op
# until one is installed.

# Site URL — used for canonical URLs, sitemap and structured data.
# Set to the production origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://prestivac.com
